# Credentials for a harness-only instance.
#
# Copy to your instance's directory as `.env`, fill in the values, and pass it with
# `--env-file`. NEVER commit a filled-in copy — the repository's .gitignore excludes
# `.env` and `*.env` for exactly this reason.
#
# The variable NAMES here are arbitrary: they only have to match the `*_ref` fields in that
# instance's /data/instance.yaml. The names below match templates/instance/*.yaml.

# --- model host -------------------------------------------------------------------------------
# Referenced by model_host.credentials_ref. Which provider it belongs to is set by
# model_host.provider (aws_bedrock | ollama_cloud | openrouter | anthropic | openai).
MODEL_HOST_API_KEY=<your model host api key>

# For model_host.provider: aws_bedrock, prefer an IAM task/pod role over static keys and leave
# MODEL_HOST_API_KEY unset. If you must use static credentials, supply them the standard way:
# AWS_ACCESS_KEY_ID=<...>
# AWS_SECRET_ACCESS_KEY=<...>
# AWS_REGION=us-east-1

# --- Paperclip --------------------------------------------------------------------------------
# Referenced by paperclip.api_key_ref. This is a long-lived Paperclip *Agent API key*, issued when
# the agent is registered — see configuration-docs/paperclip-agent-registration.md.
PAPERCLIP_AGENT_API_KEY=<your paperclip agent api key>

# --- GitHub -----------------------------------------------------------------------------------
# Referenced by identity.github_bot_account_ref; becomes GITHUB_TOKEN inside the container.
# See configuration-docs/github-cli-and-pat.md for the scopes required.
GITHUB_PAT=<your github personal access token>
