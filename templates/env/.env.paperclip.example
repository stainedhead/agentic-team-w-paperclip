# Credentials for a harness+Paperclip instance — i.e. an instance that also hosts the Paperclip
# orchestration plane itself.
#
# Everything in .env.example applies here too; this file adds Paperclip's own boot secrets.
# Copy to your instance's directory as `.env` and fill in the values. Never commit a filled-in copy.

# --- model host -------------------------------------------------------------------------------
MODEL_HOST_API_KEY=<your model host api key>

# --- Paperclip agent identity ------------------------------------------------------------------
PAPERCLIP_AGENT_API_KEY=<your paperclip agent api key>

# --- GitHub -----------------------------------------------------------------------------------
GITHUB_PAT=<your github personal access token>

# --- Paperclip server boot secrets -------------------------------------------------------------
# Required by the Paperclip server just to start, and used to sign sessions and tool-action tokens,
# so they MUST stay stable across restarts of this instance — rotating them invalidates live
# sessions. Generate each once with:
#
#     openssl rand -hex 32
#
# If you leave these unset, the entrypoint generates them on first boot and persists them under
# /data/paperclip/.secrets/ on the instance's own volume. That works, but the secret then lives
# only on that volume rather than in your secret store — supply them explicitly for anything
# beyond local experimentation.
BETTER_AUTH_SECRET=<openssl rand -hex 32>
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=<openssl rand -hex 32>

# Optional. The Paperclip server binds 0.0.0.0 inside the container by default so it is reachable
# through a published port; override only if you know you need something else.
# HOST=0.0.0.0

# Optional. Paperclip's persistent data directory. Defaults to /data/paperclip so its state lands
# on the same volume as instance.yaml. Change only if you mount a separate volume for it.
# PAPERCLIP_HOME=/data/paperclip

# Not required: Paperclip ships an embedded PostgreSQL and needs no DATABASE_URL to boot.
